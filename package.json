{
  "name": "resource-allocation-ai",
  "version": "1.0.0",
  "description": "AI-powered resource allocation platform",
  "main": "index.js",
  "scripts": {
    "start": "docker-compose up",
    "start:dev": "docker-compose up -d",
    "build": "docker-compose build",
    "test": "docker-compose run --rm frontend_test && docker-compose run --rm backend_test",
    "test:frontend": "docker-compose run --rm frontend_test",
    "test:backend": "docker-compose run --rm backend_test",
    "lint": "eslint \"frontend/src/**/*.{ts,tsx}\"",
    "format": "prettier --write \"frontend/src/**/*.{ts,tsx}\""
  },
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@testing-library/jest-dom": "^5.16.5",
    "@testing-library/react": "^13.4.0",
    "@testing-library/user-event": "^14.4.3",
    "@types/jest": "^29.5.0",
    "eslint": "^8.38.0",
    "eslint-plugin-react": "^7.32.2",
    "jest": "^29.5.0",
    "jest-environment-jsdom": "^29.5.0",
    "msw": "^1.2.1",
    "prettier": "^2.8.7"
  }
}
